# 硅谷小智 · Python 后端配置样例
# 复制为 .env 后按需修改；所有项都有默认值，最小化环境可以不建 .env

# ---------- 服务 ----------
HOST=127.0.0.1
PORT=8081

# ---------- 模型（Ollama） ----------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:7b
OLLAMA_EMBEDDING_MODEL=andersc/qwen3-embedding:0.6b
OLLAMA_TEMPERATURE=0.1
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=300
OLLAMA_MAX_RETRIES=2

# ---------- 向量库（Milvus） ----------
# 必须与 Java 版的集合分开，否则两套后端会共用同一份向量数据
MILVUS_URI=http://localhost:19530
MILVUS_ALIAS=xiaozhi_knowledge_py
RAG_MAX_RESULTS=2
RAG_DENSE_MIN_SCORE=0.35

# ---------- 数据库 ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=guiguxiaozhi
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=chat_memory_db

# ---------- 记忆 / 运行时 ----------
MEMORY_MAX_MESSAGES=20
MAX_TURNS=6
MAX_TOOL_CALLS=8
REQUEST_TIMEOUT=300

# ---------- 可靠性 / 限流 ----------
RETRY_BACKOFF_BASE=0.1
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RECOVERY_TIMEOUT=30
TOOL_FAILURE_THRESHOLD=3
DRAIN_TIMEOUT=10
ENABLE_RATE_LIMIT=true
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# ---------- 可观测 ----------
LOG_LEVEL=INFO
JSON_LOGS=true
ENABLE_METRICS=true
TRACE_MAX=500
